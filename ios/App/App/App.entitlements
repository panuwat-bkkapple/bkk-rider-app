<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Push Notifications capability.
	  "development" ใช้ได้ทั้ง debug และ TestFlight/App Store — ตอน archive
	  Xcode จะ map เป็น production APNs ให้เอง (aps-environment ใน embedded
	  provisioning profile เป็นตัวตัดสินจริง)
	-->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
